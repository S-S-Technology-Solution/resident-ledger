generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum NormalSide {
  DEBIT
  CREDIT
}

enum JournalStatus {
  DRAFT
  POSTED
  VOIDED
}

enum BillStatus {
  UNPAID
  PARTIAL
  PAID
  VOIDED
}

// Transaction batches, mirroring the accountant's existing workflow: every entry
// belongs to a monthly batch per group. Batch no. is YYMM + group code,
// e.g. 260110 = Sales, Jan 2026.
enum BatchGroup {
  SALES
  PURCHASE
  BANK
  JOURNAL
  WAGES
}

enum CashDirection {
  IN
  OUT
}

// ADMIN   — everything, including users, settings, year-end and opening balances
// TREASURER — day-to-day posting: invoices, receipts, bills, payments, journals
// VIEWER  — read-only; reports and listings, no posting
enum UserRole {
  ADMIN
  TREASURER
  VIEWER
}

model Association {
  id              String    @id @default(cuid())
  name            String
  registrationNo  String?
  address         String?
  currency        String    @default("RM")
  fiscalYearStart Int       @default(1)
  lockedThrough   DateTime?
  // Cut-over date: the day the previous system's closing balances were struck.
  openingDate     DateTime?
  createdAt       DateTime  @default(now())

  accounts  Account[]
  entries   JournalEntry[]
  residents Resident[]
  suppliers Supplier[]
  charges   Charge[]
  receipts  Receipt[]
  bills     Bill[]
  users       User[]
  batches     Batch[]
  years       FiscalYear[]
  cashEntries CashEntry[]
}

model Batch {
  id            String      @id @default(cuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id])
  batchNo       String
  group         BatchGroup
  year          Int
  month         Int
  description   String
  locked        Boolean     @default(false)
  createdAt     DateTime    @default(now())

  entries JournalEntry[]

  @@unique([associationId, batchNo])
  @@unique([associationId, group, year, month])
  @@index([associationId, year, month])
}

model FiscalYear {
  id             String      @id @default(cuid())
  associationId  String
  association    Association @relation(fields: [associationId], references: [id])
  year           Int
  closed         Boolean     @default(false)
  closedAt       DateTime?
  closedBy       String?
  closingEntryId String?
  surplus        Decimal?    @db.Decimal(15, 2)

  @@unique([associationId, year])
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  passwordHash  String
  name          String
  role          UserRole    @default(ADMIN)
  active        Boolean     @default(true)
  associationId String
  association   Association @relation(fields: [associationId], references: [id])
  createdAt     DateTime    @default(now())
}

model Account {
  id            String      @id @default(cuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id])
  code          String
  name          String
  type          AccountType
  normalSide    NormalSide
  group         String      @default("")
  classifiedAs  String?
  parentId      String?
  parent        Account?    @relation("AccountTree", fields: [parentId], references: [id])
  children      Account[]   @relation("AccountTree")
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())

  lines       JournalLine[]
  cashEntries CashEntry[]

  @@unique([associationId, code])
  @@index([associationId, type])
}

model JournalEntry {
  id            String        @id @default(cuid())
  associationId String
  association   Association   @relation(fields: [associationId], references: [id])
  entryNo       String
  date          DateTime
  description   String
  reference     String?
  status        JournalStatus @default(DRAFT)
  source        String        @default("manual")
  sourceId      String?
  batchId       String?
  batch         Batch?        @relation(fields: [batchId], references: [id])
  reversesId    String?       @unique
  reverses      JournalEntry? @relation("Reversal", fields: [reversesId], references: [id])
  reversedBy    JournalEntry? @relation("Reversal")
  postedAt      DateTime?
  postedBy      String?
  voidedAt      DateTime?
  voidReason    String?
  createdAt     DateTime      @default(now())

  lines JournalLine[]

  @@unique([associationId, entryNo])
  @@index([associationId, date])
  @@index([associationId, status])
  @@index([batchId])
}

model JournalLine {
  id        String       @id @default(cuid())
  entryId   String
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId String
  account   Account      @relation(fields: [accountId], references: [id])
  debit     Decimal      @default(0) @db.Decimal(15, 2)
  credit    Decimal      @default(0) @db.Decimal(15, 2)
  memo      String?
  lineNo    Int

  @@index([accountId])
  @@index([entryId])
}

model Resident {
  id            String      @id @default(cuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id])
  unitAddress   String
  ownerName     String
  phone         String?
  // Debtor ledger account, e.g. 3000/A01 — row letter by street + odd/even, then unit no.
  // All debtor accounts control to G/L 3000/0000 (Residents account).
  debtorCode    String?
  monthlyFee    Decimal     @default(0) @db.Decimal(15, 2)
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())

  charges  Charge[]
  receipts Receipt[]

  @@unique([associationId, unitAddress])
  @@unique([associationId, debtorCode])
}

model Charge {
  id            String      @id @default(cuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id])
  residentId    String
  resident      Resident    @relation(fields: [residentId], references: [id])
  invoiceNo     String?
  periodMonth   Int
  periodYear    Int
  amount        Decimal     @db.Decimal(15, 2)
  description   String
  date          DateTime
  voided        Boolean     @default(false)
  entryId       String?
  // Balance brought forward from the previous system. Carries no journal entry of
  // its own — the GL side comes from the single opening-balance entry, so posting
  // these individually would double-count prior-year income.
  isOpeningBalance Boolean  @default(false)
  createdAt     DateTime    @default(now())

  allocations PaymentAllocation[]

  @@unique([associationId, invoiceNo])
  @@index([residentId])
}

model Receipt {
  id            String      @id @default(cuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id])
  receiptNo     String
  residentId    String
  resident      Resident    @relation(fields: [residentId], references: [id])
  date          DateTime
  amount        Decimal     @db.Decimal(15, 2)
  method        String
  bankRef       String?
  entryId       String?
  cleared       Boolean     @default(false)
  clearedAt     DateTime?
  statementRef  String?
  voided        Boolean     @default(false)
  voidReason    String?
  // Credit balance brought forward (resident was in advance at cut-over).
  isOpeningBalance Boolean  @default(false)
  createdAt     DateTime    @default(now())

  allocations PaymentAllocation[]

  @@unique([associationId, receiptNo])
  @@index([residentId])
}

model PaymentAllocation {
  id        String  @id @default(cuid())
  receiptId String
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  chargeId  String
  charge    Charge  @relation(fields: [chargeId], references: [id])
  amount    Decimal @db.Decimal(15, 2)
}

model Supplier {
  id            String      @id @default(cuid())
  associationId String
  association   Association @relation(fields: [associationId], references: [id])
  name          String
  // Creditor ledger account, e.g. 4000/001. Controls to G/L 4000/0000 (Payables).
  creditorCode  String?
  contact       String?
  phone         String?
  bankAccount   String?
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())

  bills Bill[]

  @@unique([associationId, creditorCode])
}

model Bill {
  id               String      @id @default(cuid())
  associationId    String
  association      Association @relation(fields: [associationId], references: [id])
  supplierId       String
  supplier         Supplier    @relation(fields: [supplierId], references: [id])
  invoiceNo        String
  date             DateTime
  dueDate          DateTime?
  amount           Decimal     @db.Decimal(15, 2)
  paid             Decimal     @default(0) @db.Decimal(15, 2)
  expenseAccountId String
  status           BillStatus  @default(UNPAID)
  entryId          String?
  // Creditor balance brought forward — see Charge.isOpeningBalance.
  isOpeningBalance Boolean     @default(false)
  createdAt        DateTime    @default(now())

  payments BillPayment[]

  @@index([supplierId])
}

model BillPayment {
  id           String    @id @default(cuid())
  billId       String
  bill         Bill      @relation(fields: [billId], references: [id])
  date         DateTime
  amount       Decimal   @db.Decimal(15, 2)
  method       String    @default("BANK")
  bankRef      String?
  entryId      String?
  cleared      Boolean   @default(false)
  clearedAt    DateTime?
  statementRef String?
}

// Cash book: money in or out that is not tied to a resident or supplier —
// bank interest, one-off contributions, sundry payments. Posts straight to a GL
// account, with no debtor/creditor allocation.
model CashEntry {
  id            String        @id @default(cuid())
  associationId String
  association   Association   @relation(fields: [associationId], references: [id])
  refNo         String
  direction     CashDirection
  date          DateTime
  amount        Decimal       @db.Decimal(15, 2)
  description   String
  counterparty  String?
  method        String        @default("BANK")
  bankRef       String?
  chequeNo      String?
  accountId     String
  account       Account       @relation(fields: [accountId], references: [id])
  entryId       String?
  cleared       Boolean       @default(false)
  clearedAt     DateTime?
  statementRef  String?
  voided        Boolean       @default(false)
  voidReason    String?
  createdAt     DateTime      @default(now())

  @@unique([associationId, refNo])
  @@index([associationId, date])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  entity    String
  entityId  String
  action    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}
